# GitHub Packages credentials used only while restoring/building dependencies.
GITHUB_ACTOR=
GITHUB_TOKEN=

# Local published ports.
COMPLIANCE_HTTP_PORT=8080
FITZ_HTTP_PORT=4090
FITZ_TCP_PORT=4091
SQRZL_HTTP_PORT=9000
SQRZL_ADMIN_PORT=9001

# Production identity provider settings (Compose defaults to Development mode).
Compliance__Authentication__Mode=External
Compliance__Authentication__Authority=https://example.us.auth0.com/
Compliance__Authentication__ClientId=
Compliance__Authentication__Scopes="openid profile compliance.read"
Compliance__Authentication__AuthorizationAudience=https://compliance.example/api
Compliance__Authentication__Resources__Badgers__Authority=https://example.us.auth0.com/
Compliance__Authentication__Resources__Badgers__Audience=https://compliance.example/api
BDGRZ_SESSION_SIGNING_KEY=

# Development uses in-process mock delivery. For production, supply the following settings
# through deployment secrets to both API and worker hosts. Generate a key with:
# openssl rand -base64 32
# Compliance__EmailDelivery__Mode=smtp
# Compliance__EmailDelivery__Smtp__Host=
# Compliance__EmailDelivery__Smtp__Port=587
# Compliance__EmailDelivery__Smtp__FromAddress=
# Compliance__EmailDelivery__Smtp__Username=
# Compliance__EmailDelivery__Smtp__Password=
# Compliance__EmailDelivery__ActiveTokenKeyId=current
# Compliance__EmailDelivery__TokenKeys__current=
